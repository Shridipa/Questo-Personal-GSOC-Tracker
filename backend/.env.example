APP_ENV=development
QUESTLINE_DATABASE_PATH=data/questline.db
QUESTLINE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3002,http://127.0.0.1:3002
QUESTLINE_TIMEZONE=Asia/Kolkata
QUESTLINE_XP_LEARNING=10
QUESTLINE_XP_CODING=25
QUESTLINE_XP_MILESTONE=150

# Supabase Auth (required for JWT verification on protected endpoints)
# Get these from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
# JWT Secret (HS256 fallback — find under Project Settings → API → JWT Settings)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

